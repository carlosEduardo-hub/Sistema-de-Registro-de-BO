# Database (no Docker Compose, DATABASE_URL é sobrescrito para o serviço db)
DATABASE_URL="postgresql://docker:docker@localhost:5432/ssp_bo"

# Google Gemini (transcrição e autofill)
GEMINI_API_KEY=

# Resend (e-mails de confirmação / atualização / exclusão)
RESEND_API_KEY=

# Remetente dos e-mails
EMAIL_FROM="ssp-pi@resend.dev"

# Opcional — notificações Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
